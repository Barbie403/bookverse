<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.bookverse.boundary.WalletBoundary"
            styleClass="wallet-root"
            prefWidth="1200"
            prefHeight="780">

    <left>
        <VBox styleClass="sidebar"
              prefWidth="275"
              minWidth="250"
              spacing="8">

            <padding>
                <Insets top="28"
                        right="16"
                        bottom="28"
                        left="16"/>
            </padding>

            <Label text="BookVerse"
                   styleClass="sidebar-logo-text"/>

            <Region prefHeight="24"/>

            <Button text="Library"
                    styleClass="sidebar-button"
                    onAction="#handleBackToLibrary"
                    maxWidth="Infinity"/>

            <Button text="My Profile"
                    styleClass="sidebar-button"
                    onAction="#handleOpenProfile"
                    maxWidth="Infinity"/>

            <Button fx:id="myLibraryButton"
                    text="My Library"
                    styleClass="sidebar-button"
                    onAction="#handleOpenPurchasedBooks"
                    maxWidth="Infinity"/>

            <Button fx:id="myBooksButton"
                    text="My Books"
                    styleClass="sidebar-button"
                    onAction="#handleOpenMyBooks"
                    maxWidth="Infinity"/>

            <Button fx:id="uploadBookButton"
                    text="Upload Book"
                    styleClass="sidebar-button"
                    onAction="#handleOpenUploadBook"
                    maxWidth="Infinity"/>

            <Button text="View Wallet"
                    styleClass="sidebar-button, sidebar-button-active"
                    maxWidth="Infinity"/>

            <Button text="Log out"
                    styleClass="sidebar-button"
                    onAction="#handleLogout"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="26"
              styleClass="wallet-content">

            <padding>
                <Insets top="38"
                        right="70"
                        bottom="45"
                        left="70"/>
            </padding>

            <VBox spacing="5">

                <Label text="My Wallet"
                       styleClass="wallet-page-title"/>

                <Label text="Manage and review your BookVerse balance"
                       styleClass="wallet-page-subtitle"/>
            </VBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="22"
                  styleClass="wallet-owner-card">

                <StackPane prefWidth="82"
                           prefHeight="82"
                           minWidth="82"
                           minHeight="82"
                           maxWidth="82"
                           maxHeight="82"
                           styleClass="wallet-owner-avatar">

                    <Label fx:id="ownerInitialLabel"
                           text="B"
                           styleClass="wallet-owner-initial"/>
                </StackPane>

                <VBox spacing="5">

                    <Label fx:id="ownerNameLabel"
                           text="BookVerse User"
                           styleClass="wallet-owner-name"/>

                    <Label fx:id="roleLabel"
                           text="Wallet"
                           styleClass="wallet-owner-role"/>
                </VBox>
            </HBox>

            <VBox alignment="CENTER"
                  spacing="15"
                  styleClass="wallet-balance-card">

                <Label text="Current balance"
                       styleClass="wallet-balance-caption"/>

                <Label fx:id="balanceLabel"
                       text="€ 0.00"
                       styleClass="wallet-balance-value"/>

                <Label fx:id="descriptionLabel"
                       wrapText="true"
                       maxWidth="650"
                       styleClass="wallet-description"/>

                <Region prefHeight="4"/>

                <Button fx:id="addFundsButton"
                        text="+ Add Funds"
                        onAction="#handleAddFunds"
                        styleClass="wallet-add-funds-button"
                        prefWidth="250"/>
            </VBox>

            <VBox spacing="10"
                  styleClass="wallet-information-card">

                <Label text="How it works"
                       styleClass="wallet-information-title"/>

                <Label fx:id="howItWorksLabel"
                       wrapText="true"
                       maxWidth="820"
                       styleClass="wallet-information-text"/>
            </VBox>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   maxWidth="850"
                   styleClass="wallet-message"/>
        </VBox>
    </center>
</BorderPane>