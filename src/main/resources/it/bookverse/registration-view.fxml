<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.bookverse.boundary.RegistrationBoundary"
      styleClass="auth-root"
      prefWidth="1200"
      prefHeight="780">

    <fx:define>
        <ToggleGroup fx:id="roleToggleGroup"/>
    </fx:define>

    <StackPane styleClass="auth-image-pane"
               prefWidth="470"
               minWidth="420">

        <ImageView preserveRatio="false"
                   fitWidth="470"
                   fitHeight="780">

            <image>
                <Image url="@images/login-background.jpg"/>
            </image>
        </ImageView>

    </StackPane>

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="auth-scroll-pane"
                HBox.hgrow="ALWAYS">

        <VBox alignment="TOP_CENTER"
              styleClass="auth-form-pane"
              minHeight="780">

            <VBox spacing="15"
                  maxWidth="550">

                <padding>
                    <Insets top="38"
                            right="42"
                            bottom="45"
                            left="42"/>
                </padding>

                <VBox alignment="CENTER"
                      spacing="8">

                    <Label text="Create your account"
                           styleClass="page-title"/>

                    <Label text="Join the BookVerse community"
                           styleClass="page-subtitle"/>
                </VBox>

                <Label text="Account type"
                       styleClass="field-label"/>

                <HBox maxWidth="Infinity"
                      styleClass="role-toggle-container">

                    <ToggleButton fx:id="readerToggleButton"
                                  text="Reader"
                                  toggleGroup="$roleToggleGroup"
                                  selected="true"
                                  styleClass="role-toggle-button"
                                  maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS"/>

                    <ToggleButton fx:id="writerToggleButton"
                                  text="Writer"
                                  toggleGroup="$roleToggleGroup"
                                  styleClass="role-toggle-button"
                                  maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label text="Full name"
                       styleClass="field-label"/>

                <TextField fx:id="fullNameField"
                           promptText="Enter your full name"
                           styleClass="auth-field"
                           maxWidth="Infinity"/>

                <Label text="Email address"
                       styleClass="field-label"/>

                <TextField fx:id="emailField"
                           promptText="Enter your email address"
                           styleClass="auth-field"
                           maxWidth="Infinity"/>

                <Label text="Password"
                       styleClass="field-label"/>

                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="auth-field"
                               maxWidth="Infinity"/>

                <Label text="Confirm password"
                       styleClass="field-label"/>

                <PasswordField fx:id="confirmPasswordField"
                               promptText="Confirm your password"
                               styleClass="auth-field"
                               maxWidth="Infinity"/>

                <VBox fx:id="readerFields"
                      spacing="9">

                    <Label text="Date of birth"
                           styleClass="field-label"/>

                    <HBox spacing="10">

                        <ComboBox fx:id="birthDayComboBox"
                                  promptText="Day"
                                  styleClass="birth-date-combo"
                                  prefWidth="110"/>

                        <ComboBox fx:id="birthMonthComboBox"
                                  promptText="Month"
                                  styleClass="birth-date-combo"
                                  maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS"/>

                        <ComboBox fx:id="birthYearComboBox"
                                  promptText="Year"
                                  styleClass="birth-date-combo"
                                  prefWidth="135"/>
                    </HBox>
                </VBox>

                <VBox fx:id="writerFields"
                      spacing="9">

                    <Label text="Pen name"
                           styleClass="field-label"/>

                    <TextField fx:id="penNameField"
                               promptText="Enter your pen name"
                               styleClass="auth-field"
                               maxWidth="Infinity"/>

                    <Label text="Biography"
                           styleClass="field-label"/>

                    <TextArea fx:id="bioArea"
                              promptText="Write a short biography"
                              prefRowCount="4"
                              wrapText="true"
                              styleClass="auth-text-area"
                              maxWidth="Infinity"/>

                    <Label text="Website or social media"
                           styleClass="field-label"/>

                    <TextField fx:id="websiteField"
                               promptText="Optional"
                               styleClass="auth-field"
                               maxWidth="Infinity"/>
                </VBox>

                <Button text="Register"
                        onAction="#handleRegister"
                        styleClass="primary-button"
                        maxWidth="Infinity"/>

                <HBox alignment="CENTER"
                      spacing="4">

                    <Label text="Already have an account?"
                           styleClass="secondary-text"/>

                    <Hyperlink text="Login"
                               onAction="#handleBackToLogin"
                               styleClass="auth-link"/>
                </HBox>

                <Label fx:id="messageLabel"
                       wrapText="true"
                       styleClass="error-label"/>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>