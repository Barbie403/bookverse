<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.bookverse.boundary.PurchasedBooksBoundary"
            styleClass="purchased-root"
            prefWidth="1200"
            prefHeight="780">

    <left>
        <VBox styleClass="sidebar"
              prefWidth="275"
              minWidth="250"
              spacing="8">

            <padding>
                <Insets top="28"
                        right="16"
                        bottom="28"
                        left="16"/>
            </padding>

            <Label text="BookVerse"
                   styleClass="sidebar-logo-text"/>

            <Region prefHeight="24"/>

            <Button text="Library"
                    styleClass="sidebar-button"
                    onAction="#handleBackToLibrary"
                    maxWidth="Infinity"/>

            <Button text="My Profile"
                    styleClass="sidebar-button"
                    onAction="#handleOpenProfile"
                    maxWidth="Infinity"/>

            <Button text="My Library"
                    styleClass="sidebar-button, sidebar-button-active"
                    maxWidth="Infinity"/>

            <Button text="View Wallet"
                    styleClass="sidebar-button"
                    onAction="#handleOpenWallet"
                    maxWidth="Infinity"/>

            <Button text="Log out"
                    styleClass="sidebar-button"
                    onAction="#handleLogout"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12"
                  styleClass="sidebar-wallet-card">

                <Label text="Wallet"
                       styleClass="sidebar-wallet-title"/>

                <Label fx:id="walletBalanceLabel"
                       text="€ 0.00"
                       styleClass="sidebar-wallet-balance"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="22"
              styleClass="purchased-content">

            <padding>
                <Insets top="34"
                        right="45"
                        bottom="35"
                        left="45"/>
            </padding>

            <VBox spacing="5">
                <Label text="My Library"
                       styleClass="purchased-page-title"/>

                <Label text="Your purchased books are available here"
                       styleClass="purchased-page-subtitle"/>
            </VBox>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   styleClass="purchased-message"/>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="purchased-scroll-pane"
                        VBox.vgrow="ALWAYS">

                <FlowPane fx:id="purchasedBooksContainer"
                          orientation="VERTICAL"
                          hgap="18"
                          vgap="18"
                          prefWrapLength="820">

                    <padding>
                        <Insets top="5"
                                right="12"
                                bottom="30"
                                left="2"/>
                    </padding>
                </FlowPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>