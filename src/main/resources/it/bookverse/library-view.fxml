<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.bookverse.boundary.LibraryBoundary"
            styleClass="library-root"
            prefWidth="1200"
            prefHeight="780">

    <left>
        <VBox styleClass="sidebar"
              prefWidth="275"
              minWidth="250"
              spacing="8">

            <padding>
                <Insets top="28"
                        right="16"
                        bottom="28"
                        left="16"/>
            </padding>

            <Label text="BookVerse"
                   styleClass="sidebar-logo-text"/>

            <Region prefHeight="24"/>

            <Button text="Library"
                    styleClass="sidebar-button, sidebar-button-active"
                    maxWidth="Infinity"/>

            <Button text="My Profile"
                    styleClass="sidebar-button"
                    onAction="#handleOpenProfile"
                    maxWidth="Infinity"/>

            <Button fx:id="myLibraryButton"
                    text="My Library"
                    styleClass="sidebar-button"
                    onAction="#handleOpenPurchasedBooks"
                    maxWidth="Infinity"/>

            <Button fx:id="myBooksButton"
                    text="My Books"
                    styleClass="sidebar-button"
                    onAction="#handleOpenMyBooks"
                    maxWidth="Infinity"/>

            <Button fx:id="uploadBookButton"
                    text="Upload Book"
                    styleClass="sidebar-button"
                    onAction="#handleOpenUploadBook"
                    maxWidth="Infinity"/>

            <Button text="View Wallet"
                    styleClass="sidebar-button"
                    onAction="#handleOpenWallet"
                    maxWidth="Infinity"/>

            <Button text="Log out"
                    styleClass="sidebar-button"
                    onAction="#handleLogout"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12"
                  styleClass="sidebar-wallet-card">

                <Label text="Wallet"
                       styleClass="sidebar-wallet-title"/>

                <Label fx:id="walletBalanceLabel"
                       text="€ 0.00"
                       styleClass="sidebar-wallet-balance"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="library-content"
              spacing="24">

            <padding>
                <Insets top="28"
                        right="35"
                        bottom="30"
                        left="35"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="18">

                <HBox alignment="CENTER_LEFT"
                      styleClass="library-search-box"
                      HBox.hgrow="ALWAYS">

                    <Label text="⌕"
                           styleClass="library-search-icon"/>

                    <TextField fx:id="searchField"
                               promptText="Search books by title, category or description..."
                               styleClass="library-search-field"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="×"
                            onAction="#handleClearSearch"
                            styleClass="library-clear-button"/>
                </HBox>

                <VBox alignment="CENTER_LEFT"
                      spacing="2">

                    <Label fx:id="accountNameLabel"
                           text="Welcome"
                           styleClass="library-account-name"/>

                    <Label fx:id="accountRoleLabel"
                           text="User"
                           styleClass="library-account-role"/>
                </VBox>
            </HBox>

            <VBox spacing="4">

                <Label text="Discover Books"
                       styleClass="library-page-title"/>

                <Label text="Find your next adventure"
                       styleClass="library-page-subtitle"/>
            </VBox>

            <HBox spacing="10">

                <Button text="All genres"
                        styleClass="category-filter, category-filter-active"
                        onAction="#handleClearSearch"/>

                <Button text="Fantasy"
                        styleClass="category-filter"
                        onAction="#handleFantasyFilter"/>

                <Button text="Fiction"
                        styleClass="category-filter"
                        onAction="#handleFictionFilter"/>

                <Button text="Romance"
                        styleClass="category-filter"
                        onAction="#handleRomanceFilter"/>

                <Button text="Sci-Fi"
                        styleClass="category-filter"
                        onAction="#handleScienceFictionFilter"/>
            </HBox>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   styleClass="library-message"/>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="library-scroll-pane"
                        VBox.vgrow="ALWAYS">

                <FlowPane fx:id="booksContainer"
                          hgap="18"
                          vgap="18"
                          prefWrapLength="850">

                    <padding>
                        <Insets top="4"
                                right="5"
                                bottom="25"
                                left="2"/>
                    </padding>
                </FlowPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>